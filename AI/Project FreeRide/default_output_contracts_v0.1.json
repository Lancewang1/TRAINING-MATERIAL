{
  "schema_version": "default_output_contract.v0.1",
  "taxonomy_version": "intent_routing.v1.0",
  "status": "confirmed",
  "confirmed_date": "2026-09-04",
  "merge": {
    "mode": "dual_field_merge",
    "formula": "effective_output = shared_output_envelope + skill.base_output + primary_action_overlay + secondary_action_overlays + conditional_slot_overlays + requested_output",
    "overlay_order": "primary_action_then_secondary_actions_then_conditional_slot_overlays_in_declared_order",
    "primary_precedence": ["explicit_user", "action_overlay", "skill_base"],
    "list_merge": "stable_deduplicating_union",
    "envelope_merge": "prepend_shared_required_components_and_stable_union",
    "secondary_action_rule": "secondary_actions_must_be_leaf_action_ids; unresolved_family_hints_are_not_compiled",
    "secondary_artifact_rule": "a_secondary_primary_artifact_is_appended_to_additional_artifacts_when_primary_is_already_set",
    "conditional_slot_rule": "apply_only_the_overlay_matching_a_resolved_input_slot_or_mode",
    "missing_conditional_overlay_behavior": "treat_as_empty",
    "presentation_rule": "merge_when_compatible_clarify_when_mutually_exclusive",
    "negative_request_rule": "explicit_user_suppresses_default_and_is_recorded_in_system_trace",
    "unsupported_output_rule": "preserve_request_and_return_coverage_or_fallback_status"
  },
  "canonical_aliases": {
    "action_type": {
      "participate/pass": "participate_or_pass",
      "IPT_update": "ipt_update",
      "DCF": "dcf",
      "KPI_bridge": "kpi_bridge"
    },
    "model_template": {
      "operating+DCF": "operating+DCF"
    }
  },
  "shared_output_envelope": {
    "merge_into": "effective_output.required_components",
    "required_components": [
      "as_of_date",
      "source_trace",
      "availability_status",
      "assumption_provenance",
      "coverage_limitations"
    ],
    "provenance_values": ["user_provided", "skill_default", "model_derived", "source_lookup"],
    "availability_values": ["available", "not_released", "unavailable", "not_applicable"],
    "presentation_values": ["narrative", "table", "chart", "one_liner", "workbook", "raw_data"]
  },
